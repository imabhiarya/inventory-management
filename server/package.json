{
  "name": "mes-store-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "restore-backup": "node --env-file-if-exists=.env scripts/restore-backup.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "backfill:ledger-pages": "node --env-file-if-exists=.env scripts/backfill-ledger-pages.js",
    "test": "vitest run",
    "migrate:loan-store": "node --env-file-if-exists=.env scripts/migrate-loan-store.js",
    "reconcile": "node --env-file-if-exists=.env scripts/reconcile-stock.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.12.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  }
}

# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=production
PORT=5000

# MongoDB MUST be a replica set (stock postings use transactions).
# Single-node replica set is fine: mongod --replSet rs0, then rs.initiate() once.
MONGODB_URI=mongodb://127.0.0.1:27017/mes_store?replicaSet=rs0

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Session length in hours
JWT_EXPIRES_IN_HOURS=8

# Set to true when served over HTTPS (default: true in production).
# Set to false ONLY when testing production mode over plain http://localhost.
# COOKIE_SECURE=true

# Behind a reverse proxy (nginx etc.) set the number of proxy hops, e.g. 1
# TRUST_PROXY=1

# Only needed if the client is hosted on a different origin than the API
# CORS_ORIGIN=https://store.example.org

LOG_LEVEL=info
